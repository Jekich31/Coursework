<Window x:Class="WpfApp2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource m_WindowTitle}" Height="700" Width="1000"
        Background="#F4F6F9" WindowStartupLocation="CenterScreen">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Menu Grid.Row="0" Background="Transparent" Margin="0,0,0,10">
            <MenuItem Header="{DynamicResource m_Language}">
                <MenuItem Header="Українська" Command="{Binding ChangeLanguageCommand}" CommandParameter="UKR"/>
                <MenuItem Header="English" Command="{Binding ChangeLanguageCommand}" CommandParameter="EN"/>
            </MenuItem>
        </Menu>

        <GroupBox Grid.Row="1" Header="{DynamicResource m_AddTitle}" Margin="0,0,0,15" Padding="10" Background="White">
            <WrapPanel Orientation="Horizontal">
                <StackPanel Margin="5">
                    <TextBlock Text="{DynamicResource m_Vin}"/>
                    <TextBox Text="{Binding Vin, UpdateSourceTrigger=PropertyChanged}" Width="110"/>
                </StackPanel>

                <StackPanel Margin="5">
                    <TextBlock Text="{DynamicResource m_Type}"/>
                    <ComboBox ItemsSource="{Binding VehicleTypes}" SelectedItem="{Binding SelectedVehicleType}" Width="130"/>
                </StackPanel>

                <StackPanel Margin="5">
                    <TextBlock Text="{DynamicResource m_Brand}"/>
                    <TextBox Text="{Binding Brand, UpdateSourceTrigger=PropertyChanged}" Width="100"/>
                </StackPanel>

                <StackPanel Margin="5">
                    <TextBlock Text="{DynamicResource m_Model}"/>
                    <TextBox Text="{Binding Model, UpdateSourceTrigger=PropertyChanged}" Width="100"/>
                </StackPanel>

                <StackPanel Margin="5">
                    <TextBlock Text="{DynamicResource m_Latitude}"/>
                    <TextBox Text="{Binding Latitude, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                </StackPanel>

                <StackPanel Margin="5">
                    <TextBlock Text="{DynamicResource m_Longitude}"/>
                    <TextBox Text="{Binding Longitude, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                </StackPanel>

                <StackPanel Margin="5">
                    <TextBlock Text="{DynamicResource m_Capacity}"/>
                    <TextBox Text="{Binding Capacity, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                </StackPanel>

                <Button Content="{DynamicResource m_AddButton}" Command="{Binding AddVehicleCommand}" 
                        Margin="10,16,5,5" Padding="12,5" Background="#2ECC71" Foreground="White" FontWeight="Bold"/>
            </WrapPanel>
        </GroupBox>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="{DynamicResource m_Refresh}" Command="{Binding LoadVehiclesCommand}" Margin="0,0,10,0" Padding="10,5"/>
            <Button Content="{DynamicResource m_Delete}" Command="{Binding DeleteVehicleCommand}" Padding="10,5" Background="#E74C3C" Foreground="White"/>
        </StackPanel>

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <ListBox ItemsSource="{Binding Vehicles}" SelectedItem="{Binding SelectedVehicle}" 
                     Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>

                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="5"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Width="290" Background="White" CornerRadius="10" Padding="15" Margin="5">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Direction="270" Color="#000000" Opacity="0.08"/>
                            </Border.Effect>

                            <StackPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <StackPanel DockPanel.Dock="Left">
                                        <TextBlock Text="{Binding Brand}" FontSize="16" FontWeight="Bold" Foreground="#2C3E50"/>
                                        <TextBlock Text="{Binding Model}" FontSize="13" Foreground="#7F8C8D"/>
                                    </StackPanel>

                                    <Border DockPanel.Dock="Right" CornerRadius="5" Padding="8,3" VerticalAlignment="Top">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#E74C3C"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Engine}" Value="Running">
                                                        <Setter Property="Background" Value="#2ECC71"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>

                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="6" Height="6" Fill="White" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Engine}" FontSize="11" FontWeight="Bold" Foreground="White"/>
                                        </StackPanel>
                                    </Border>
                                </DockPanel>

                                <Separator Background="#ECF0F1" Margin="0,0,0,8"/>

                                <UniformGrid Columns="2" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="VIN" FontSize="10" Foreground="#BDC3C7" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding Vin}" FontSize="11" Foreground="#34495E"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource m_ColLocation}" FontSize="10" Foreground="#BDC3C7" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding LocationData}" FontSize="11" Foreground="#34495E"/>
                                    </StackPanel>
                                </UniformGrid>

                                <TextBlock Text="{DynamicResource m_ColLevel}" FontSize="10" Foreground="#7F8C8D" Margin="0,0,0,2"/>
                                <ProgressBar Value="{Binding CurrentLevel, Mode=OneWay}" Maximum="{Binding Capacity, Mode=OneWay}" 
                                             Height="8" Foreground="#2ECC71" Background="#ECF0F1" BorderThickness="0" Margin="0,0,0,2"/>
                                <TextBlock Text="{Binding CurrentLevel}" FontSize="10" HorizontalAlignment="Right" Foreground="#95A5A6" Margin="0,0,0,8"/>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <TextBlock Text="{DynamicResource m_ColDoors}" FontSize="11" Foreground="#7F8C8D" Margin="0,0,5,0"/>
                                    <TextBlock Text="{Binding Doors}" FontSize="11" FontWeight="Bold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#E67E22"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Doors}" Value="Locked">
                                                        <Setter Property="Foreground" Value="#27AE60"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>

                                <UniformGrid Columns="2">
                                    <Button Content="{DynamicResource m_ToggleEngine}" 
                                            Command="{Binding DataContext.ToggleEngineCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            Background="#3498DB" Foreground="White" BorderThickness="0" Padding="4" Margin="0,0,3,0"/>

                                    <Button Content="{DynamicResource m_ToggleDoors}" 
                                            Command="{Binding DataContext.ToggleDoorsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            Background="#E67E22" Foreground="White" BorderThickness="0" Padding="4" Margin="3,0,0,0"/>
                                </UniformGrid>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </ScrollViewer>
    </Grid>
</Window>