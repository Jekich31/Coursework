<Window x:Class="ProjectFIN.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource m_WindowTitle}" Height="600" Width="950">
    <DockPanel>
        <Menu DockPanel.Dock="Top" Background="#F0F0F0" Padding="5">
            <MenuItem Header="{DynamicResource m_Language}">
                <MenuItem Header="Українська" 
                          Command="{Binding ChangeLanguageCommand}" 
                          CommandParameter="UKR"/>
                <MenuItem Header="English" 
                          Command="{Binding ChangeLanguageCommand}" 
                          CommandParameter="EN"/>
            </MenuItem>
        </Menu>

        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <GroupBox Header="{DynamicResource m_AddTitle}" Grid.Row="0" Margin="0,0,0,10" Padding="5">
                <WrapPanel Orientation="Horizontal">
                    <StackPanel Margin="5">
                        <TextBlock Text="{DynamicResource m_Vin}"/>
                        <TextBox Text="{Binding Vin, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                    </StackPanel>

                    <StackPanel Margin="5">
                        <TextBlock Text="{DynamicResource m_Type}"/>
                        <ComboBox ItemsSource="{Binding VehicleTypes}" SelectedItem="{Binding SelectedVehicleType}" Width="100"/>
                    </StackPanel>

                    <StackPanel Margin="5">
                        <TextBlock Text="{DynamicResource m_Brand}"/>
                        <TextBox Text="{Binding Brand, UpdateSourceTrigger=PropertyChanged}" Width="100"/>
                    </StackPanel>

                    <StackPanel Margin="5">
                        <TextBlock Text="{DynamicResource m_Model}"/>
                        <TextBox Text="{Binding Model, UpdateSourceTrigger=PropertyChanged}" Width="100"/>
                    </StackPanel>

                    <StackPanel Margin="5">
                        <TextBlock Text="{DynamicResource m_Latitude}"/>
                        <TextBox Text="{Binding Latitude, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                    </StackPanel>

                    <StackPanel Margin="5">
                        <TextBlock Text="{DynamicResource m_Longitude}"/>
                        <TextBox Text="{Binding Longitude, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                    </StackPanel>

                    <StackPanel Margin="5">
                        <TextBlock Text="{DynamicResource m_Capacity}"/>
                        <TextBox Text="{Binding Capacity, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                    </StackPanel>

                    <Button Content="{DynamicResource m_AddButton}" Command="{Binding AddVehicleCommand}" Margin="5,16,5,5" Padding="10,2"/>
                </WrapPanel>
            </GroupBox>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                <Button Content="{DynamicResource m_Refresh}" Command="{Binding LoadVehiclesCommand}" Margin="0,0,10,0" Padding="10,5"/>
                <Button Content="{DynamicResource m_ToggleEngine}" Command="{Binding ToggleEngineCommand}" Margin="0,0,10,0" Padding="10,5" Background="#E1F5FE"/>
                <Button Content="{DynamicResource m_ToggleDoors}" Command="{Binding ToggleDoorsCommand}" Margin="0,0,10,0" Padding="10,5" Background="#FFFDE7"/>
                <Button Content="{DynamicResource m_Delete}" Command="{Binding DeleteVehicleCommand}" Padding="10,5" Background="#FFEBEE"/>
            </StackPanel>

            <DataGrid Grid.Row="2" ItemsSource="{Binding Vehicles}" SelectedItem="{Binding SelectedVehicle}" AutoGenerateColumns="False" IsReadOnly="True">
                <DataGrid.Columns>

                    <DataGridTextColumn Binding="{Binding Vin}" Width="*">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{DynamicResource m_ColVin}"/>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>

                    <DataGridTextColumn Binding="{Binding Brand}" Width="*">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{DynamicResource m_ColBrand}"/>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>

                    <DataGridTextColumn Binding="{Binding Model}" Width="*">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{DynamicResource m_ColModel}"/>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>

                    <DataGridTextColumn Binding="{Binding Engine}" Width="*">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{DynamicResource m_ColEngine}"/>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>

                    <DataGridTextColumn Binding="{Binding Doors}" Width="*">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{DynamicResource m_ColDoors}"/>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>

                    <DataGridTextColumn Binding="{Binding LocationData}" Width="*">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{DynamicResource m_ColLocation}"/>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>

                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </DockPanel>
</Window>